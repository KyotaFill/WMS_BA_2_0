<mxfile host="app.diagrams.net" type="device"><diagram id="post_sequence" name="post_sequence"><mxGraphModel page="1" pageWidth="1680" pageHeight="1190"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Trình tự ghi sổ và xử lý timeout" style="text;whiteSpace=wrap;align=left;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="10" width="1610" height="40" /></mxCell><mxCell id="note" value="6a-6b là nhánh lỗi; 7a-8 là nhánh hợp lệ. Chỉ báo POSTED sau COMMIT. NOT_FOUND không cho phép đổi key." style="text;whiteSpace=wrap;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1142" width="1610" height="40" /></mxCell><mxCell id="Operator" value="Nhân viên" style="whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#526d87;fontSize=16;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="75" width="270" height="65" /></mxCell><mxCell id="UI" value="Tkinter Presenter" style="whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#526d87;fontSize=16;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="75" width="270" height="65" /></mxCell><mxCell id="API" value="FastAPI Handler" style="whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#526d87;fontSize=16;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="75" width="270" height="65" /></mxCell><mxCell id="DB" value="PostgreSQL" style="whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#526d87;fontSize=16;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="75" width="270" height="65" /></mxCell><mxCell id="edge0" edge="1" parent="1" style="edgeStyle=none;endArrow=block;endFill=1;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="235" y="205" /><mxPoint as="targetPoint" x="605" y="205" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge_label0" value="1. Xác nhận ghi sổ online" style="text;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="334.23828125" y="173" width="171.5234375" height="25" /></mxCell><mxCell id="edge1" edge="1" parent="1" style="edgeStyle=none;endArrow=block;endFill=1;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="605" y="280" /><mxPoint as="targetPoint" x="1035" y="280" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge_label1" value="2. Persist key/payload, rồi POST + version + key" style="text;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="658.9921875" y="248" width="322.015625" height="25" /></mxCell><mxCell id="edge2" edge="1" parent="1" style="edgeStyle=none;endArrow=block;endFill=1;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1035" y="355" /><mxPoint as="targetPoint" x="1465" y="355" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge_label2" value="3. BEGIN; serialize idempotency key" style="text;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1125.81640625" y="323" width="248.3671875" height="25" /></mxCell><mxCell id="edge3" edge="1" parent="1" style="edgeStyle=none;endArrow=block;endFill=1;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1035" y="430" /><mxPoint as="targetPoint" x="1465" y="430" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge_label3" value="4. Check quyền, khóa document / period / location" style="text;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="1084.26171875" y="398" width="331.4765625" height="25" /></mxCell><mxCell id="edge4" edge="1" parent="1" style="edgeStyle=none;endArrow=block;endFill=1;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1035" y="505" /><mxPoint as="targetPoint" x="1465" y="505" /><Array as="points" /></mxGeometry></mxCell><mxCell id="edge_label4" value="5. Khóa stock item / balance / reservation" style="text;whiteSpace=wr