ent><bpmn:endEvent id="end_reject" name="Chờ làm rõ; giữ khóa"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="a" name="" /><bpmn:sequenceFlow id="Flow_1" sourceRef="a" targetRef="b" name="" /><bpmn:sequenceFlow id="Flow_2" sourceRef="b" targetRef="c" name="" /><bpmn:sequenceFlow id="Flow_3" sourceRef="c" targetRef="d" name="" /><bpmn:sequenceFlow id="Flow_4" sourceRef="d" targetRef="g" name="" /><bpmn:sequenceFlow id="Flow_5" sourceRef="g" targetRef="f" name="Đạt" /><bpmn:sequenceFlow id="Flow_6" sourceRef="f" targetRef="e" name="" /><bpmn:sequenceFlow id="Flow_7" sourceRef="g" targetRef="end_reject" name="Không đạt" /></bpmn:process><bpmn:collaboration id="Collaboration"><bpmn:participant id="InternalPool" name="Doanh nghiệp" processRef="Process_P03_COUNT" /></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="DI_InternalPool" bpmnElement="InternalPool"><dc:Bounds x="65" y="120" width="1090" height="1255" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_0" bpmnElement="Lane_0"><dc:Bounds x="100" y="150" width="340" height="1225" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_1" bpmnElement="Lane_1"><dc:Bounds x="440" y="150" width="340" height="1225" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_2" bpmnElement="Lane_2"><dc:Bounds x="780" y="150" width="340" height="1225" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_s" bpmnElement="s"><dc:Bounds x="249.0" y="190" width="42" height="42" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_a" bpmnElement="a"><dc:Bounds x="155.0" y="335" width="230" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_b" bpmnElement="b"><dc:Bounds x="835.0" y="480" width="230" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_c" bpmnElement="c"><dc:Bounds x="155.0" y="625" width="230" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_d" bpmnElement="d"><dc:Bounds x="495.